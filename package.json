{
  "name": "school-management-backend",
  "version": "1.0.0",
  "private": true,
  "description": "School management backend — api, Hasura, Docker stack",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "postinstall": "npm install --prefix api",
    "dev": "npm run dev --prefix api",
    "start": "npm run start --prefix api",
    "test": "npm run test --prefix api",
    "test:watch": "npm run test:watch --prefix api",
    "sms": "bash scripts/sms help",
    "hasura:up": "bash scripts/sms stack console-ready",
    "hasura:down": "bash scripts/sms stack down",
    "console": "bash scripts/sms hasura console",
    "hasura:verify": "bash scripts/sms hasura verify-webhooks",
    "stack:up": "bash scripts/sms stack up",
    "stack:up:infra": "bash scripts/sms stack up --infra-only",
    "stack:down": "bash scripts/sms stack down",
    "stack:down:v": "bash scripts/sms stack down -v",
    "stack:ps": "bash scripts/sms stack ps",
    "stack:logs": "bash scripts/sms stack logs",
    "stack:logs:hasura": "bash scripts/sms stack logs hasura",
    "stack:logs:app": "bash scripts/sms stack logs app",
    "stack:logs:postgres": "bash scripts/sms stack logs postgres",
    "stack:logs:redis": "bash scripts/sms stack logs redis",
    "stack:restart": "bash scripts/sms stack restart",
    "stack:restart:hasura": "bash scripts/sms stack restart hasura",
    "stack:restart:app": "bash scripts/sms stack restart app",
    "db:setup": "bash scripts/sms db setup",
    "db:migrate": "bash scripts/sms db migrate",
    "db:baseline": "bash scripts/sms db baseline",
    "db:status": "bash scripts/sms db status",
    "db:seed": "bash scripts/sms db seed",
    "db:seed:fees": "bash scripts/sms db seed-fees",
    "db:reset": "bash scripts/sms db reset",
    "seed:school": "bash scripts/sms seed school",
    "seed:super": "bash scripts/sms seed super",
    "seed:provider": "bash scripts/sms seed provider",
    "seed:demo": "bash scripts/sms seed demo",
    "seed:grading": "bash scripts/sms seed grading",
    "qa:smoke": "bash scripts/sms qa smoke",
    "qa:audit-tenant": "bash scripts/sms qa audit-tenant",
    "audit:tenant": "bash scripts/sms qa audit-tenant",
    "smoke": "bash scripts/sms qa smoke",
    "dev:chapa": "bash scripts/sms dev chapa",
    "worker:compute": "node scripts/workers/computation-worker.mjs"
  }
}
