# ─── Core API ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3003
DATABASE_URL=postgres://sms_user:sms_pass@127.0.0.1:5432/sms_db

# JWT signing (must match Hasura HASURA_GRAPHQL_JWT_SECRET key)
ACCESS_TOKEN_SECRET=dev_access_secret_min_32_characters_long

# Shared secret: API validates header; Hasura injects via metadata value_from_env
ACTION_SECRET=supersecret

# ─── Hasura ──────────────────────────────────────────────────────────────────
HASURA_GRAPHQL_ADMIN_SECRET=supersecret
HASURA_GRAPHQL_ENABLE_CONSOLE=true

# Webhook base URL as seen FROM the Hasura container (never localhost unless Hasura runs on host):
#   Full Docker stack:     http://app:3003
#   API on host (npm run dev): http://host.docker.internal:3003  (+ compose.host-api.yml)
HASURA_ACTION_BASE_URL=http://app:3003

# Optional publish ports (docker compose)
# POSTGRES_PUBLISH_PORT=5432
# HASURA_PUBLISH_PORT=8082
# API_PUBLISH_PORT=3003

# ─── Redis (logout blacklist) ────────────────────────────────────────────────
# Host API: local Redis. Docker API: redis://redis:6379 (set automatically in compose).
REDIS_URL=redis://127.0.0.1:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── Optional: Chapa (parent portal) ─────────────────────────────────────────
# CHAPA_SECRET_KEY=
# CHAPA_MODE=test
