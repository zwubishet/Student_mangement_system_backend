DATABASE_URL=postgres://sms_user:sms_pass@localhost:5432/sms_db
DB_POOL_MAX=10
DB_SSL=false
HASURA_ENDPOINT=http://localhost:8082/v1/graphql
HASURA_ADMIN_SECRET=supersecret
ACTION_SECRET=supersecret
HASURA_GRAPHQL_JWT_SECRET={"type":"HS256","key":"your_32_char_secret_here_minimum"}
ACCESS_TOKEN_SECRET=your_access_token_secret_here

# S3-compatible storage: AWS S3, Cloudflare R2, MinIO
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://cdn.example.com/school-files
S3_REGION=auto
S3_BUCKET=school-files
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
PORT=3004
NODE_ENV=development
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173
