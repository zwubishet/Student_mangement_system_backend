DATABASE_URL=postgres://sms_user:sms_pass@localhost:5432/sms_db
DB_POOL_MAX=10
DB_SSL=false
# Hasura engine root (used by sms-dev.sh / Hasura CLI). App uses HASURA_GRAPHQL_ENDPOINT in docker-compose.
HASURA_ENDPOINT=http://localhost:8082
HASURA_ADMIN_SECRET=supersecret
ACTION_SECRET=supersecret
HASURA_GRAPHQL_JWT_SECRET={"type":"HS256","key":"your_32_char_secret_here_minimum"}
ACCESS_TOKEN_SECRET=your_access_token_secret_here

# S3-compatible storage: AWS S3, Cloudflare R2, MinIO
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://cdn.example.com/school-files
S3_REGION=auto
S3_BUCKET=school-files
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
PORT=3004
NODE_ENV=development
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# Chapa — https://dashboard.chapa.co → Settings → API Keys (TEST key for local)
# Webhook (optional locally): Dashboard → Webhooks → URL https://YOUR-NGROK/api/v1/finance/webhooks/chapa
CHAPA_SECRET_KEY=CHAPUBK_TEST-YWt5uyhoJY6bDNQW5sDPk2uJkCsV9N4o
CHAPA_WEBHOOK_SECRET=any-random-string-you-set-in-chapa-webhook-settings
CHAPA_MODE=test
CHAPA_BASE_URL=https://api.chapa.co/v1
API_PUBLIC_URL=http://localhost:3004
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
