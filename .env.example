# ─── Required (production) ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3003
DATABASE_URL=postgres://sms_user:CHANGE_ME@localhost:5432/sms_db
ACCESS_TOKEN_SECRET=generate-a-long-random-string-min-32-chars
ACTION_SECRET=generate-another-long-random-string

# ─── Hasura (if using GraphQL console / cloud) ───────────────────────────────
HASURA_GRAPHQL_ADMIN_SECRET=change-me-not-supersecret
HASURA_GRAPHQL_DATABASE_URL=${DATABASE_URL}

# ─── Redis (logout token blacklist) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CORS (comma-separated origins; no * in production) ─────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── Optional: file uploads (local dev) ─────────────────────────────────────
# UPLOAD_DIR=./storage/uploads
# PUBLIC_FILE_BASE_URL=http://localhost:3003/files

# ─── Optional: Chapa payments (parent portal) ────────────────────────────────
# CHAPA_SECRET_KEY=
# CHAPA_MODE=test

# ─── Optional: Neon / remote DB migrations ───────────────────────────────────
# NEON_DATABASE_URL=postgresql://user:pass@host.neon.tech/neondb?sslmode=require
